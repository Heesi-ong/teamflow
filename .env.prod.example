# docker-compose.prod.yml이 참조하는 환경변수. 실제 값을 채운 뒤 .env로 저장한다(Git 미포함).
# 배포 서버(EC2)에는 이 파일을 .env로 직접 준비해두고, deploy.yml은 이를 덮어쓰지 않는다.

DB_PASSWORD=
JWT_SECRET=
S3_BUCKET=
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GRAFANA_ADMIN_PASSWORD=

# GitHub Container Registry에서 이미지를 pull할 때 쓰는 저장소 소유자/태그.
# deploy.yml이 배포 시점의 git sha로 IMAGE_TAG를 덮어써서 compose를 실행한다.
GHCR_OWNER=heesi-ong
IMAGE_TAG=latest
